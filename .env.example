# Copy to .env.local for local development, or set these in the Vercel project.
# Every one of these is optional - the app runs without any of them.

# Enables Claude-written answers in the chat widget. Without it the widget
# returns the matching knowledge base steps verbatim, which still works.
ANTHROPIC_API_KEY=

# Overrides the chat model. Defaults to claude-opus-5-5.
ANTHROPIC_MODEL=

# Where the callback form's submissions are forwarded.
# Defaults to the n8n webhook hardcoded in api/callback.js.
WEBHOOK_URL=

# Where "Raise a ticket" sends tickets. Until this is set the chat widget
# says ticketing is not connected rather than inventing a reference number.
TICKET_WEBHOOK_URL=
