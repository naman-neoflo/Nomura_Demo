# Copy to .env for local development, or set these in the Vercel project.

# One key covers both jobs: embeddings (to build and query the FAISS index)
# and the chat model that writes the answers.
#   https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Chat model. Any OpenRouter slug; see https://openrouter.ai/models
# Default: anthropic/claude-opus-5.5
OPENROUTER_MODEL=

# Embedding model. Must match what the index was built with - kb/kb_index.json
# records it, and queries are embedded with that model regardless of this value.
# Rebuild the index after changing it.
# Default: openai/text-embedding-3-small
EMBEDDING_MODEL=

# Retrieval confidence floors. Override only after running
# scripts/test_retrieval.py, which prints the separation to calibrate against.
BM25_FLOOR=
VECTOR_FLOOR=

# Where the callback form's submissions are forwarded.
# Defaults to the n8n webhook in api/callback.py.
WEBHOOK_URL=

# Where "Raise a ticket" sends tickets. Until this is set the chat widget says
# ticketing is not connected rather than inventing a reference number.
TICKET_WEBHOOK_URL=
